# /etc/sxhkd/sxhkdrc

# Volume settingsa

# Volume settings for PipeWire
XF86AudioRaiseVolume
    wpctl set-volume @DEFAULT_SINK@ 5%+ && wpctl get-volume @DEFAULT_SINK@

XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_SINK@ 5%- && wpctl get-volume @DEFAULT_SINK@

XF86AudioMute
    wpctl set-mute @DEFAULT_SINK@ toggle

XF86AudioMicMute
    wpctl set-mute @DEFAULT_SOURCE@  toggle
Print
    flameshot gui

XF86MonBrightnessDown
    brightnessctl s 5%-

XF86MonBrightnessUp
    brightnessctl s 5%+
