(defvar nowPlayingArt "broken")

(defwidget musicQuickControl []
  
  (box :class "musicQuickControl"
    :halign "center"
    :valign "center"
    (box :orientation "h"
      (button :class "green" :onclick "echo 'prev'" "󰒮")
      (button :class "purple" :onclick "echo 'prev'" "p")
      (button :class "green" :onclick "echo 'prev'" "󰒭")
    )
    (label :class "title" :text "Song") 
    (label :class "artist" :text "your mom" )
    (label :class "album" :text " aa" )
    
  )
  
)



