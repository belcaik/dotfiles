(deflisten CLOCKLISTEN :initial '{"date":"", "time":""}' "/home/belcaik/Dev/SabiStat/target/release/SabiStat --clock")
(defwidget clock []
  (box
    :class "clock"
    :halign "center"    
    (label :text "${CLOCKLISTEN.time}"
      :class "time"
      :halign "end"
      :tooltip "${CLOCKLISTEN.date}"
    )
  )
)
